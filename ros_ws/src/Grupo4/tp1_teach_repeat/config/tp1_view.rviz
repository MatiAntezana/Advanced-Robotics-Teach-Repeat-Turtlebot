Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: odom
    Background Color: 24; 29; 35
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 30
      Alpha: 0.15
      Color: 100; 110; 120
    - Class: rviz_default_plugins/RobotModel
      Name: TurtleBot3
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
      Alpha: 1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: true
      Show Axes: true
      Show Arrows: true
      Marker Scale: 0.25
      Frames:
        All Enabled: true
    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR localizado
      Enabled: true
      Topic:
        Value: /tnr/localized_scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 5
      Size (m): 0.015
      Style: Points
      Size (Pixels): 2
      Color Transformer: FlatColor
      Color: 240; 240; 240
      Position Transformer: XYZ
    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR crudo (TF historica)
      Enabled: false
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 5
      Size (m): 0.025
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 255; 100; 100
      Position Transformer: XYZ
    - Class: rviz_default_plugins/PointCloud2
      Name: Nube original (diagnostico)
      Enabled: false
      Topic:
        Value: /tnr/reference_map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
      Color Transformer: FlatColor
      Color: 100; 130; 150
      Position Transformer: XYZ
      Size (m): 0.025
      Style: Flat Squares
    - Class: rviz_default_plugins/MarkerArray
      Name: Mapa 2D - paredes
      Enabled: true
      Topic:
        Value: /tnr/reference_walls
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
    - Class: rviz_default_plugins/Map
      Name: Ocupacion (diagnostico)
      Enabled: false
      Topic:
        Value: /tnr/reference_grid
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: Keyframes
      Enabled: true
      Topic:
        Value: /tnr/keyframes
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
    - Class: rviz_default_plugins/Path
      Name: Teach
      Enabled: true
      Color: 255; 155; 35
      Line Style: Billboards
      Line Width: 0.075
      Offset:
        X: 0
        Y: 0
        Z: 0.015
      Buffer Length: 1
      Topic:
        Value: /tnr/teach_path
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
    - Class: rviz_default_plugins/Path
      Name: Repeat
      Enabled: true
      Color: 0; 245; 230
      Line Style: Billboards
      Line Width: 0.035
      Offset:
        X: 0
        Y: 0
        Z: 0.025
      Buffer Length: 1
      Topic:
        Value: /tnr/repeat_path
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: Setpoint y alineacion
      Enabled: true
      Topic:
        Value: /tnr/navigation_markers
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
    - Class: rviz_default_plugins/Odometry
      Name: Localización relativa
      Enabled: false
      Keep: 1
      Topic:
        Value: /rel_odom
        Reliability Policy: Reliable
        Depth: 5
      Covariance:
        Value: false
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Angle: 0
      Scale: 65
      X: 1.5
      Y: 3.0
      Target Frame: <Fixed Frame>
Window Geometry:
  Width: 1250
  Height: 800
